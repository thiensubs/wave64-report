+// ---------------------------------------------------------------------------
+// Column-tiled SIMT GEMM for GPUs without simdgroup_matrix (pre-Apple7, e.g.
+// Polaris). The matvec fallback dispatches one threadgroup per output column,
+// so it streams the weight matrix once per column. Here a threadgroup owns a
+// BM x BN output tile and reads each weight tile once, which is the whole point:
+// weight traffic drops by BN for an unchanged arithmetic count.
+// ---------------------------------------------------------------------------
+
+template<typename T0, typename T1>
+inline void kernel_mul_mm_simt_impl(
+        constant ggml_metal_kargs_mul_mv & args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        threadgroup  float * shmem,
+        uint3  tgpig,
+        ushort tiitg) {
+    constexpr short BM = 32;
+    constexpr short BN = 32;
+    constexpr short BK = 64;
+    // 2x2 outputs per thread: a 32x32 tile on 256 threads keeps the threadgroup
+    // small enough for several resident groups per CU, which is what a 1024-thread
+    // 32x32 tile gave up (measured 18% slower).
+    constexpr short NT = (BM/2)*(BN/2);
+
+    threadgroup float * sA = shmem;
+    threadgroup float * sB = shmem + BM*BK;
+
+    const int m0 = tgpig.x*BM;
+    const int n0 = tgpig.y*BN;
+    const int im = tgpig.z;
+
+    const int i12 = im % args.ne12;
+    const int i13 = im / args.ne12;
+
+    const uint64_t off0 = (uint64_t)(i12/args.r2)*args.nb02 + (uint64_t)(i13/args.r3)*args.nb03;
+    const uint64_t off1 = (uint64_t)i12*args.nb12 + (uint64_t)i13*args.nb13;
+
+    device const T0 * A = (device const T0 *) (src0 + off0);
+    device const T1 * B = (device const T1 *) (src1 + off1);
+
+    const short thm = tiitg / 16;
+    const short thn = tiitg % 16;
+
+    const uint64_t s0 = args.nb01/sizeof(T0);
+    const uint64_t s1 = args.nb11/sizeof(T1);
+
+    float acc00 = 0.0f, acc01 = 0.0f, acc10 = 0.0f, acc11 = 0.0f;
+
+    for (int k0 = 0; k0 < args.ne00; k0 += BK) {
+        for (int i = tiitg; i < BM*BK; i += NT) {
+            const int lm = i / BK;
+            const int lk = i % BK;
+            const int gm = m0 + lm;
+            const int gk = k0 + lk;
+            float v = 0.0f;
+            if (gm < args.ne01 && gk < args.ne00) {
+                v = (float) A[(uint64_t)gm*s0 + gk];
+            }
+            sA[i] = v;
+        }
+        for (int i = tiitg; i < BK*BN; i += NT) {
+            const int lk = i / BN;
+            const int ln = i % BN;
+            const int gk = k0 + lk;
+            const int gn = n0 + ln;
+            float v = 0.0f;
+            if (gk < args.ne00 && gn < args.ne11) {
+                v = B[(uint64_t)gn*s1 + gk];
+            }
+            sB[i] = v;
+        }
+
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+
+        for (short k = 0; k < BK; ++k) {
+            const float a0 = sA[(2*thm + 0)*BK + k];
+            const float a1 = sA[(2*thm + 1)*BK + k];
+            const float b0 = sB[k*BN + 2*thn + 0];
+            const float b1 = sB[k*BN + 2*thn + 1];
+
+            acc00 += a0*b0;
+            acc01 += a0*b1;
+            acc10 += a1*b0;
+            acc11 += a1*b1;
+        }
+
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+
+    device float * dst_f32 = (device float *) dst;
+    const uint64_t base = (uint64_t)im*args.ne0*args.ne1;
+
+    const int gm0 = m0 + 2*thm;
+    const int gm1 = gm0 + 1;
+    const int gn0 = n0 + 2*thn;
+    const int gn1 = gn0 + 1;
+
+    if (gm0 < args.ne01 && gn0 < args.ne11) dst_f32[base + (uint64_t)gn0*args.ne0 + gm0] = acc00;
+    if (gm0 < args.ne01 && gn1 < args.ne11) dst_f32[base + (uint64_t)gn1*args.ne0 + gm0] = acc01;
+    if (gm1 < args.ne01 && gn0 < args.ne11) dst_f32[base + (uint64_t)gn0*args.ne0 + gm1] = acc10;
+    if (gm1 < args.ne01 && gn1 < args.ne11) dst_f32[base + (uint64_t)gn1*args.ne0 + gm1] = acc11;
+}
